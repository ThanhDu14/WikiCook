 id="3. 12" value="AiPlannerService" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="635" y="75" width="160" height="30" as="geometry"/></mxCell><mxCell id="3. 13" value="&lt;b&gt;RecipeEmbeddingRepository&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="635" y="115" width="160" height="30" as="geometry"/></mxCell><mxCell id="3. 14" value="&lt;b&gt;AiRequestRepository&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="635" y="155" width="160" height="30" as="geometry"/></mxCell><mxCell id="3. 15" value="&lt;b&gt;nutrition&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="820" y="40" width="180" height="200" as="geometry"/></mxCell><mxCell id="3. 16" value="NutritionService" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="830" y="75" width="160" height="30" as="geometry"/></mxCell><mxCell id="3. 17" value="&lt;b&gt;RecipeNutritionRepository&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="830" y="115" width="160" height="30" as="geometry"/></mxCell><mxCell id="3. 18" value="&lt;b&gt;shopping&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1015" y="40" width="180" height="200" as="geometry"/></mxCell><mxCell id="3. 19" value="ShoppingService" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1025" y="75" width="160" height="30" as="geometry"/></mxCell><mxCell id="3. 20" value="&lt;b&gt;ShoppingListRepository&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1025" y="115" width="160" height="30" as="geometry"/></mxCell><mxCell id="3. 21" value="⇄ Giao tiếp giữa module qua &lt;b&gt;port / facade&lt;/b&gt;: DietaryProfilePort, RecipeSummaryPort, MealPlanWriteFacade, MealPlanShoppingFacade" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="1150" height="50" as="geometry"/></mxCell><mxCell id="3. 22" value="&lt;font style='font-size:10px' color='#888888'&gt;&lt;b&gt;SHARED DATA REPOSITORY&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;PostgreSQL 16 + pgvector&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;users · recipes · ingredients · meal_plans · meal_plan_items&lt;br&gt;recipe_embeddings · recipe_nutrition · ai_requests · shopping_lists&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="400" y="380" width="430" height="160" as="geometry"/></mxCell><mxCell id="3. 23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;edgeStyle=none;dashed=1;strokeColor=#9673a6;" edge="1" parent="1" source="3. 1" target="3. 22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="3. 24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;edgeStyle=none;dashed=1;strokeColor=#9673a6;" edge="1" parent="1" source="3. 4" target="3. 22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="3. 25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;edgeStyle=none;dashed=1;strokeColor=#9673a6;" edge="1" parent="1" source="3. 7" target="3. 22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="3. 26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;edgeStyle=none;dashed=1;strokeColor=#9673a6;" edge="1" parent="1" source="3. 11" target="3. 22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="3. 27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;edgeStyle=none;dashed=1;strokeColor=#9673a6;" edge="1" parent="1" source="3. 15" target="3. 22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="3. 28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;edgeStyle=none;dashed=1;strokeColor=#9673a6;" edge="1" parent="1" source="3. 18" target="3. 22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="3. 29" value="&lt;font color='#888888' style='font-size:11px'&gt;Tên Service/Repository của auth, recipe, shopping là minh họa (chưa có plan chi tiết). Còn lại lấy từ plan 030 / 031 / 090.&lt;/font&gt;" style="text;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="900" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="4. " name="4. Pipe-and-filter"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="4. 1" value="&lt;b&gt;a) Pipeline RAG – AI Weekly Meal Planner (spec 031)&lt;/b&gt;" style="text;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="700" height="30" as="geometry"/></mxCell><mxCell id="4. 2" value="&lt;font style='font-size:10px' color='#888888'&gt;&lt;b&gt;INPUT&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Hồ sơ người dùng&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Dị ứng, kiểu ăn, thời gian nấu&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="160" height="100" as="geometry"/></mxCell><mxCell id="4. 3" value="&lt;font style='font-size:10px' color='#888888'&gt;&lt;b&gt;FILTER 1&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Lọc hard rule&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;SQL: dị ứng, loại trừ, PUBLISHED, hợp bữa&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="230" y="50" width="160" height="100" as="geometry"/></mxCell><mxCell id="4. 4" value="&lt;font style='font-size:10px' color='#888888'&gt;&lt;b&gt;FILTER 2&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Truy hồi top-K&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;pgvector trên recipe_embeddings&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="420" y="50" width="160" height="100" as="geometry"/></mxCell><mxCell id="4. 5" value="&lt;font style='font-size:10px' color='#888888'&gt;&lt;b&gt;FILTER 3&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;LLM xếp ô&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Gemini Flash, JSON mode&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="1"><mxGeometry x="610" y="50" width="160" height="100" as="geometry"/></mxCell><mxCell id="4. 6" value="&lt;font style='font-size:10px' color='#888888'&gt;&lt;b&gt;FILTER 4&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Validate&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Kiểm từng pick; JSON hỏng → retry 1 lần&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="800" y="50" width="160" height="100" as="geometry"/></mxCell><mxCell id="4. 7" value="&lt;font style='font-size:10px' color='#888888'&gt;&lt;b&gt;OUTPUT&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Draft kế hoạch tuần&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Trả về client để xác nhận&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="990" y="50" width="160" height="100" as="geometry"/></mxCell><mxCell id="4. 8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="4. 2" target="4. 3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="4. 9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="4. 3" target="4. 4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="4. 10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="4. 4" target="4. 5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="4. 11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="4. 5" target="4. 6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="4. 12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="4. 6" target="4. 7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="4. 13" value="&lt;font style='font-size:10px' color='#888888'&gt;&lt;b&gt;FILTER 5&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Fallback greedy&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Tất định, ≤ 2 s&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize