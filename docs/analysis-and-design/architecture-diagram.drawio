<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" type="device"><diagram id="1. " name="1. Client-Server"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="1. 1" value="CLIENT TIER" style="fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="300" height="300" as="geometry"/></mxCell><mxCell id="1. 2" value="SERVER TIER" style="fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="460" y="20" width="460" height="300" as="geometry"/></mxCell><mxCell id="1. 3" value="&lt;font style='font-size:10px' color='#888888'&gt;&lt;b&gt;CLIENT&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;React 18 SPA / PWA (Vite)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;• Trình duyệt desktop &amp;amp; mobile&lt;br&gt;• Lớp API client dùng chung&lt;br&gt;• Lưu JWT, render UI&lt;br&gt;• Draft AI plan chỉ giữ ở client&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="260" height="200" as="geometry"/></mxCell><mxCell id="1. 4" value="&lt;font style='font-size:10px' color='#888888'&gt;&lt;b&gt;SERVER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Spring Boot 3.x (Java 21)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;REST API stateless · Spring Security · Service · Repository&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="480" y="60" width="420" height="90" as="geometry"/></mxCell><mxCell id="1. 5" value="&lt;font style='font-size:10px' color='#888888'&gt;&lt;b&gt;DATA SERVER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;PostgreSQL 16 + pgvector&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Flyway migration&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="480" y="190" width="190" height="110" as="geometry"/></mxCell><mxCell id="1. 6" value="&lt;font style='font-size:10px' color='#888888'&gt;&lt;b&gt;DỊCH VỤ NGOÀI&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Gemini API (LLM)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;API key chỉ nằm ở backend&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="1"><mxGeometry x="710" y="200" width="190" height="90" as="geometry"/></mxCell><mxCell id="1. 7" value="HTTPS · REST/JSON&lt;br&gt;/api/v1 + JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;startArrow=block;startFill=1;" edge="1" parent="1" source="1. 3" target="1. 4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1. 8" value="JDBC" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="1. 4" target="1. 5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1. 9" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="1. 4" target="1. 6"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="2. " name="2. Layered"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2. 1" value="&lt;b&gt;Presentation&lt;/b&gt;&lt;br&gt;&lt;font color='#888888' style='font-size:11px'&gt;Client&lt;/font&gt;" style="text;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="170" height="70" as="geometry"/></mxCell><mxCell id="2. 2" value="&lt;b&gt;React UI&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Pages, components, API client&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="230" y="40" width="560" height="70" as="geometry"/></mxCell><mxCell id="2. 3" value="&lt;b&gt;API / Controller&lt;/b&gt;&lt;br&gt;&lt;font color='#888888' style='font-size:11px'&gt;controller/&lt;/font&gt;" style="text;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="170" height="70" as="geometry"/></mxCell><mxCell id="2. 4" value="&lt;b&gt;@RestController + Security Filter Chain&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Nhận request, Bean Validation, map DTO, ProblemDetail&lt;br&gt;VD: MealPlanController, AiPlannerController&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="230" y="150" width="560" height="70" as="geometry"/></mxCell><mxCell id="2. 5" value="&lt;b&gt;Business / Service&lt;/b&gt;&lt;br&gt;&lt;font color='#888888' style='font-size:11px'&gt;service/&lt;/font&gt;" style="text;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="170" height="70" as="geometry"/></mxCell><mxCell id="2. 6" value="&lt;b&gt;Domain services&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Toàn bộ business logic&lt;br&gt;VD: MealPlanService, SlotMoveService, AiQuotaService, AI orchestration&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="230" y="260" width="560" height="70" as="geometry"/></mxCell><mxCell id="2. 7" value="&lt;b&gt;Persistence&lt;/b&gt;&lt;br&gt;&lt;font color='#888888' style='font-size:11px'&gt;repository/&lt;/font&gt;" style="text;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="170" height="70" as="geometry"/></mxCell><mxCell id="2. 8" value="&lt;b&gt;Spring Data JPA Repositories&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Entity ↔ bảng, query tham số hóa&lt;br&gt;VD: MealPlanRepository, RecipeEmbeddingRepository&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="230" y="370" width="560" height="70" as="geometry"/></mxCell><mxCell id="2. 9" value="&lt;b&gt;Database&lt;/b&gt;" style="text;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="170" height="80" as="geometry"/></mxCell><mxCell id="2. 10" value="&lt;b&gt;PostgreSQL 16 + pgvector&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Migration Flyway (V301, V303…)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="230" y="480" width="560" height="80" as="geometry"/></mxCell><mxCell id="2. 11" value="JSON DTO" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;startArrow=block;startFill=1;" edge="1" parent="1" source="2. 2" target="2. 4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="2. 12" value="gọi Service" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="2. 4" target="2. 6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="2. 13" value="gọi Repository" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="2. 6" target="2. 8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="2. 14" value="SQL / JDBC" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="2. 8" target="2. 10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="2. 15" value="&lt;b&gt;Quy tắc (Constitution – Nguyên tắc III)&lt;/b&gt;&lt;br&gt;• Controller KHÔNG gọi thẳng Repository&lt;br&gt;• Business logic chỉ nằm ở Service&lt;br&gt;• API trả DTO record, không trả Entity JPA&lt;br&gt;• Package theo tính năng: controller/ service/ repository/ dto/" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="830" y="150" width="300" height="200" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3. " name="3. Repository"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="3. 1" value="&lt;b&gt;auth / user&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="180" height="200" as="geometry"/></mxCell><mxCell id="3. 2" value="UserService" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="50" y="75" width="160" height="30" as="geometry"/></mxCell><mxCell id="3. 3" value="&lt;b&gt;UserRepository&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="50" y="115" width="160" height="30" as="geometry"/></mxCell><mxCell id="3. 4" value="&lt;b&gt;recipe&