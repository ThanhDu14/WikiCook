# Copy to .env and set a password: cp .env.example .env
POSTGRES_DB=wikicook
POSTGRES_USER=wikicook
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# AI (spec 031/090): mock | offline | live. live needs a Gemini API key; never commit the real key.
WIKICOOK_AI_MODE=mock
WIKICOOK_AI_API_KEY=
# Rows that call the LLM per day (00:00 Vietnam time), split 70/30 between meal planner and nutrition.
WIKICOOK_AI_DAILY_CAP_TOTAL=100
