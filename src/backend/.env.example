# Copy to .env and set a password: cp .env.example .env
POSTGRES_DB=wikicook
POSTGRES_USER=wikicook
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# AI (spec 031/090): mock | offline | live. live needs a Gemini API key; never commit the real key.
WIKICOOK_AI_MODE=mock
WIKICOOK_AI_API_KEY=
# Rows that call the LLM per day (00:00 Vietnam time), split 70/30 between meal planner and nutrition.
WIKICOOK_AI_DAILY_CAP_TOTAL=100
# Embed published recipes once at startup (spends provider quota); 0 = no limit per run.
WIKICOOK_AI_EMBEDDING_RECONCILE_ON_STARTUP=false
WIKICOOK_AI_EMBEDDING_RECONCILE_LIMIT=0

# Dev only: stand-ins for login (X-Dev-User-Id header), dietary profile and meal plan storage until 010/030 land.
WIKICOOK_DEV_STUBS_ENABLED=false
WIKICOOK_DEV_STUBS_USER_ID=1

# Auth (spec 010). No real values here; put them in .env (git-ignored).
# JWT signing secret, at least 32 bytes. Generate: openssl rand -base64 48
WIKICOOK_JWT_SECRET=
# HMAC key for email hashes (login attempts, send limits, blocked emails). Generate: openssl rand -base64 48
# Do not change it once data exists: every stored email_hash would stop matching.
WIKICOOK_EMAIL_HASH_KEY=
# Base URL used in email links and the Google redirect
WIKICOOK_PUBLIC_BASE_URL=http://localhost:3000
# Refresh cookie "Secure" flag: true behind HTTPS, false on plain http://localhost
WIKICOOK_AUTH_COOKIE_SECURE=false
# SMTP (docker compose runs mailpit on 1025, UI on http://localhost:8025)
MAIL_HOST=
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
WIKICOOK_MAIL_FROM=no-reply@wikicook.local
# Appeal contact shown in suspension/ban emails; empty falls back to WIKICOOK_MAIL_FROM
WIKICOOK_APPEAL_CONTACT=
# Google sign-in (spec 010 US5). Both empty: the "Continue with Google" button goes back to /login with a notice and
# e-mail sign-in is unaffected. Both set: create an OAuth client (type "Web application") in Google Cloud Console,
# register this redirect URI exactly, and paste the id and secret here. Never commit the real values.
#   redirect URI = ${WIKICOOK_PUBLIC_BASE_URL}/api/v1/auth/oauth2/callback/google
#   e.g. http://localhost:5173/api/v1/auth/oauth2/callback/google (dev server) or http://localhost:3000/... (Compose)
WIKICOOK_GOOGLE_CLIENT_ID=
WIKICOOK_GOOGLE_CLIENT_SECRET=
# First administrator, created at startup when both are set and no administrator exists
WIKICOOK_BOOTSTRAP_ADMIN_EMAIL=
WIKICOOK_BOOTSTRAP_ADMIN_PASSWORD=

# Avatars (spec 011): directory the app writes to. Compose sets /var/lib/wikicook/media (volume "media") itself.
WIKICOOK_MEDIA_DIR=./.media
